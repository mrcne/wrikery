root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Golden files are compared byte for byte, an editor must not touch their trailing spaces or add a final newline.
[*.golden]
insert_final_newline = false
trim_trailing_whitespace = false
